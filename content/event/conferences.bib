@inproceedings{whitneyDecisionAnalysisApproach2025,
	address = {Bonn, Germany},
	title = {A {Decision} {Analysis} {Approach} for {Optimizing} {School} {Garden} {Interventions} - {Addressing} {Child} {Health}, {Biodiversity}, and {Economic} {Outcomes}},
	doi = {10.13140/RG.2.2.33599.16802},
	abstract = {This study evaluates the impacts of school gardens in Vietnam, focusing on child health, biodiversity,
and economic outcomes across public and private schools. We assessed five investment scenarios
using decision analysis, including school gardens with and without integration of STEM (Science,
Technology, Engineering, and Math) education into the garden. It includes specialized teaching
equipment and teacher training to enhance learning experiences. curriculum and schools without
gardens. We mapped impact pathways to identify trade-offs, risks, and uncertainties, employing
Monte Carlo simulations, sensitivity analysis, Pareto optimization, and Expected Value of Perfect
Information (EVPI) to guide decision-making.
Our Pareto optimization model revealed trade-offs among economic, biodiversity, and health
outcomes. Gardens without STEM integration consistently provided greater health benefits. STEM
gardens, particularly in public schools, faced financial and operational challenges. Key success drivers
included garden-related events, teacher training, and community support, highlighting the critical role
of targeted investments in addressing uncertainties in economic returns. We used Non-dominated
Sorting Genetic Algorithm II (NSGA-II) to explore 2500 Monte Carlo simulation runs to approximate
Pareto fronts for each scenario. Optimal configurations were reached when garden size and frequency
of public school events were maximized. Integrating animals in the garden increased child health
benefits while reducing overall economic return. Public schools showed strong potential for
biodiversity improvements with minimal economic trade-offs, while private schools demonstrated
higher economic feasibility, especially when leveraging gardens to enhance reputation and enrollment.
Our integrated analytical approach provides actionable insights for policymakers and educators to
optimize school garden interventions. These approaches can foster sustainable food environments and
improve child health.},
	booktitle = {8th {International} {BioSC} {Symposium}},
	publisher = {Bioeconomy Science Center},
	author = {Whitney, Cory and Kopton, Johannes and Luedeling, Eike and Luu, Thi Giang},
	year = {2025},
	pages = {25},
}

@inproceedings{doAgroforestryAdaptationIndividual2025,
	address = {Kunming,China},
	title = {Agroforestry adaptation in individual households in northwestern {Vietnam}: who needs what and implications for practice and policy},
	abstract = {Agroforestry is promoted in northwestern Vietnam to enhance environmental sustainability and support
livelihoods, especially in resource-constrained settings. Its adoption is hindered by farm-level and structural barriers,
necessitating interventions tailored to diverse needs of farmers. Employing a participatory approach, we developed a
farm typology to understand the heterogeneity among agroforestry farmers by analyzing data from 101 households
through archetypal analysis. This analysis identified three distinct agroforestry archetypes, each reflecting unique
resource constraints. Archetype 1 (Al) and archetype 2 (A2) operate small-sized farms with limited agricultural labor
and diversified livelihood activities. Al farmers manage concentrated land and maximize land and labor use efficiency by
integrating diverse agroforestry systems. In contrast, A2 farmers deal with high land fragmentation and small-sized
plots, which restricts the diversification of agroforestry systems. Archetype 3 operates the largest farms, focusing their
livelihood on cash crops with the lowest adoption level and moderate species diversity in their agroforestry systems. We
used the archetype profiles to discuss with farmers potential interventions to improve their engagement in sustainable
agroforestry practices. Strategic interventions include improving market access, providing financial support for inputs
and tree seedlings and establishing irrigation systems. Practical interventions involve diversifying agroforestry systems
and enhancing technical knowledge. We discuss potential socio-technical solutions and challenges and opportunities for
their implementation. Our study emphasizes the importance of tailored interventions to meet diverse farmer needs anc
contributes to the co-creation and design of farming systems. It facilitates learning from varied farmer behaviors and
strategies, ensuring the practicality and local relevance of proposed solutions.},
	booktitle = {Proceedings {THE} 3rd {INTERNATIONAL} {AGROBIODIVERSITY} {CONGRESS}},
	author = {Do, Hoa and Luedeling, Eike and Whitney, Cory},
	year = {2025},
	pages = {31},
}

@inproceedings{sangingaUnpackingOutcomesTradeoffs2025,
	address = {Mons, Belgium},
	title = {Unpacking the outcomes and trade-offs of {Integrated} {Soil} {Fertility} {Management} with probabilistic modeling approaches},
	abstract = {Sustainable intensification practices aim to increase agricultural productivity and farmer profits on existing land while minimizing negative environmental and social impacts. However, selecting the best practices to scale requires robust decision-making due to the complexity of agricultural systems and the risk of unintended consequences for vulnerable groups. Integrated Soil Fertility Management (ISFM) is being promoted in Northern Ghana as a sustainable intensification practice. However, ISFM outcomes and trade-offs across the dimensions of the Sustainable Intensification Assessment Framework (SIAF) (productivity, economic, social, and environmental domains) remain unclear. Because current assessment approaches of the outcomes of agricultural practices often fail to capture the complexity of agricultural systems in a holistic manner, we propose a probabilistic modeling approach to assess ISFM. This modelling approach incorporates risks, uncertainties, costs, and benefits of ISFM and uses Monte Carlo simulations to simulate and forecast the SIAF outcomes of ISFM in maize and soybean systems. By capturing the complexity of agricultural systems and providing evidence-based insights, our findings inform decisions on ISFM adoption and policy interventions, ensuring that trade-offs are acknowledged and equitable agricultural practices are promoted.},
	booktitle = {26th {International} {Conference} of the {Society} for {Human} {Ecology}},
	author = {Sanginga, Dorcas and Whitney, Cory and Miranda, Javier and Asare-Nuamah, Peter and Dierks, Janina and Luedeling, Eike},
	year = {2025},
}

