  title = {Determinants of pigeonpea adoption among smallholder farmers across three agro-ecological zones in Uganda},
  volume = {12},
  doi = {10.1016/j.heliyon.2026.e45470},
  number = {15},
  journal = {Heliyon},
  author = {Angella Kyobutungi and Jimmy Obala and Cory Whitney and Wyclife Agumba Oluoch and John R.S. Tabuti},
  year = {2026},
  pages = {e45470},
  file = {PDF:/Users/corywhitney/Zotero/storage/DS2HSGUB/Kyobutungi et al. - 2026 - Determinants of pigeonpea adoption among smallholder farmers across three agro-ecological zones in U.pdf:application/pdf},
  abstract = {Pigeonpea (Cajanus cajan (L.) Millsp.) is an important food crop with the potential to address food security concerns in Uganda. Its cultivation, however, remains limited to a few parts of the country. Yet, reports indicate that nearly 80% of the country's land is suitable for crop production. It is, therefore, important to determine the factors responsible for this variable adoption. This study aimed to determine the factors responsible for the restricted cultivation of pigeonpea in Uganda. The research was conducted in three agro-ecological zones that have varying levels of pigeonpea production. Data were collected through semi-structured interviews with 285 respondents. Bayesian logistic regression analysis was applied to determine the factors that influence the adoption of pigeonpea cultivation; Fisher's exact test was used as a robustness check. Adoption of pigeonpea was significantly influenced by farmer location, age, and education level. Differential adoption among agroecological zones was explained by seed source, extension contact, information channels, market proximity, transport infrastructure and farmers' perceived crop benefits and trait preferences. These findings provide evidence for designing targeted agroecological zone interventions to promote sustainable adoption of pigeonpea for food security and climate change adaptation across Uganda.},
