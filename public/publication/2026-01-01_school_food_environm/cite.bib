  author = {Pham Thi Minh Phuong and Nguyen Ngoc Bich and Luu Quoc Toan and Le Thi Thanh Huong and Le Thi Thu Ha and Luu Thi Thu Giang and Cory Whitney and Dinh Thi Kim Anh},
