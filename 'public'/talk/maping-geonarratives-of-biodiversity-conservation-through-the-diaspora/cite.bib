  file = {Whitney - 2024 - Maping geonarratives of biodiversity conservation .pdf:/Users/corywhitney/Zotero/storage/A2LWQV2E/Whitney - 2024 - Maping geonarratives of biodiversity conservation .pdf:application/pdf},
  abstract = {One of the untapped resources for advancing biodiversity conservation and enriching its discourse for inclusivity and decolonization are members of the diaspora. Some biodiversity scientists from the Global South are now based in the Global North, with some of them still connected to their home country by conducting research there. But apart from these experts, how do common migrants connect (or disconnect) with ecologies of their home countries? This workshop will engage participants from the diaspora in co-creating a countermap of global biodiversity science efforts, pinning down the situatedness of diaspora stories, and foregrounding the intersections, movements, tensions, and stories in which “becoming-diaspora in conservation” takes place. The ZooMap project funded by the Volkswagen Foundation at the Eberswalde University for Sustainable Development (HNEE) is inviting you to our Berlin Science Week Invited Programme Event!},
  url = {https://berlinscienceweek.com/programme/mapping-geonarratives-biodiversity-conservation-through-diaspora},
  date = {2024-01-01},
}
